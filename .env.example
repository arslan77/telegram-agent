# From @BotFather. Full international numbers, comma-separated.
# Only these numbers can use the bot, after they share their Telegram contact.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_PHONES=

# Optional. Folder the agent starts in. It must be inside your home directory.
# CURSOR_WORKSPACE=

# Optional. Cursor model name. Empty uses the CLI default.
# CURSOR_MODEL=
